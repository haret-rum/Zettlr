	},
	"nodes":[
		{
			"id":"3472d67633a473b1",
			"styleAttributes":{},
			"text":"عقلي",
			"type":"text",
			"x":0,
			"y":-10,
			"width":120,
			"height":60,
			"color":"6"
		},
		{
			"id":"76f6dc307c053725",
			"styleAttributes":{},
			"text":"مأخوذة من الكتاب والسنة والإجماع",
			"type":"text",
			"x":-330,
			"y":-100,
			"width":260,
			"height":60
		},
		{
			"id":"34b36e5df0b5455c",
			"styleAttributes":{},
			"text":"**البرهان**\nما تألف من مقدمات يقينية، بأن يكون اعتقادها جازما مطابقا ثابتا لا يتغير",
			"type":"text",
			"x":-450,
			"y":15,
			"width":380,
			"height":110
		},
		{
			"id":"0e994aafd6ffbea0",
			"styleAttributes":{},
			"text":"**الجدل**\nوهو ما تركب من قضايا مشهورة أومسلمة بين الخصمين، سواء كانت صادقة أم كاذبة، ليبني عليها الكلام في دفع كل من الخصمين صاحبه",
			"type":"text",
			"x":-450,
			"y":145,
			"width":380,
			"height":140
		},
		{
			"id":"d004c76a847c0e66",
			"styleAttributes":{},
			"text":"**الخطابة**\nوهو ما تركب من مقدمة مقبولة، أو مظنونة",
			"type":"text",
			"x":-450,
			"y":305,
			"width":380,
			"height":80
		},
		{
			"id":"4d4e43ddf8065682",
			"styleAttributes":{},
			"text":"**الشعر** \nوهو ما تألف من قضايا تنبسط منها النفس أو تنقبض",
			"type":"text",
			"x":-430,
			"y":405,
			"width":360,
			"height":140
		},
		{
			"id":"b523e477d9872806",
			"styleAttributes":{},
			"text":"**السفسطة**\nوهي ما تألف من مقدمات باطلة شبيهة بالحق ",
			"type":"text",
			"x":-450,
			"y":565,
			"width":380,
			"height":100
		},
		{
			"id":"8371d6883798988c",
			"styleAttributes":{},
			"text":"**نحو** الخمر ياقوتة سيالة، والعسل مرةمهوعة",
			"type":"text",
			"x":-780,
			"y":455,
			"width":260,
			"height":100
		},
		{
			"id":"1718003bbe8202b6",
			"styleAttributes":{},
			"text":"**نحو** قولنا في صورة فرس في حائط: \nهذا فرس \nوكل فرس صهال\n∴ فهذا صهال",
			"type":"text",
			"x":-820,
			"y":575,
			"width":300,
			"height":160
		},
		{
			"id":"f4aa2763eecca23b",
			"styleAttributes":{},
			"text":"**نحو** العدل حسن، والظلم قبيح",
			"type":"text",
			"x":-780,
			"y":205,
			"width":260,
			"height":60
		},
		{
			"id":"a612fa95ba848b3d",
			"styleAttributes":{},
			"text":"**نحو** القضية الصادرة من شخص يعتقد صلاحه، والقضية التي محكم بها العقل بواسطة الظن",
			"type":"text",
			"x":-780,
			"y":285,
			"width":260,
			"height":150
		},
		{
			"id":"0732175fabd722fc",
			"styleAttributes":{},
			"text":"## اليقينيات",
			"type":"text",
			"x":-800,
			"y":28,
			"width":260,
			"height":85,
			"color":"5"
		},
		{
			"id":"7ca3ba54c7daf567",
			"styleAttributes":{},
			"text":"**المجربات**\nوهي ما حكم به العقل والحس مع التكرار.\n**نحو** قولنا السقمونيا مسهلة، والخمر مسكر.",
			"type":"text",
			"x":-1240,
			"y":120,
			"width":340,
			"height":140
		},
		{
			"id":"c3cbf26ed6f7c446",
			"styleAttributes":{},
			"text":"**المتوترات**\n وهي ما حكم بها العقل مع حاسة السمع.\n**نحو** كعلمنا بغزة والشافعي",
			"type":"text",
			"x":-1240,
			"y":300,
			"width":340,
			"height":140
		},
		{
			"id":"6e054c2feb8449fc",
			"styleAttributes":{},
			"text":"**الحدسيات**\nوهي ما حكم بها العقل والحس من غير توقف على تكرار.\n**نحو** العلم بأن نور القمر مستفاد من نور الشمس، أيم الظن بذلك ظنا قوي",
			"type":"text",
			"x":-1240,
			"y":480,
			"width":340,
			"height":165
		},
		{
			"id":"49f3d2c4e1c2b161",
			"styleAttributes":{},
			"text":"**المحسوسات**\nوهي ما يدرك بإحدى الحواس الخمس الظاهرة، التي هي السمع والبصر والشم والذوق واللمس\n",
			"type":"text",
			"x":-1240,
			"y":685,
			"width":340,
			"height":135
		},
		{
			"id":"6ff0dc274799d2a1",
			"styleAttributes":{},
			"text":"**الأوليات**\nوهو ما حكم فيه العقل من غير واسطة تتوقف على تأمل. \n**نحو** السماء فوقنا، والأرض تحتنا",
			"type":"text",
			"x":-1240,
			"y":-240,
			"width":340,
			"height":140
		},
		{
			"id":"00f23faa3143e6a9",
			"styleAttributes":{},
			"text":"**المشاهدات**\nوهي ما تدرك بالحواس الباطنة من \nغير توقف على عقل\n**نحو** جوع الإنسان وعطشه، ولذته وألمه.",
			"type":"text",
			"x":-1240,
			"y":-60,
			"width":340,
			"height":140
		},
		{
			"id":"81065c4eb1076ac1",
			"styleAttributes":{},
			"text":"نقلي",
			"type":"text",
			"x":0,
			"y":-100,
			"width":120,
			"height":60,
			"color":"6"
		},
		{
			"id":"673f81c8b3ba05c0",
			"styleAttributes":{},
			"text":"#  الحجة",
			"type":"text",
			"x":180,
			"y":-70,
			"width":180,
			"height":90,
			"color":"6"
		}
	]
}