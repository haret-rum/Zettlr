	"nodes":[
		{
			"id":"9b0374ba171eb31d",
			"styleAttributes":{},
			"text":"الجالس في السفينة يتحرك\nوكل متحرك لا يثبت في موضع واحد \n∴ الجالس في السفينة لا يثبت في موضع واحد",
			"type":"text",
			"x":-540,
			"y":50,
			"width":380,
			"height":100
		},
		{
			"id":"6d22c6b3753f5d93",
			"styleAttributes":{},
			"text":"هذه نقلة\nوكل نقلة حركة\n∴ هذه حركة",
			"type":"text",
			"x":-340,
			"y":170,
			"width":180,
			"height":90
		},
		{
			"id":"56b84e93924d8076",
			"styleAttributes":{},
			"text":"الفرس حيوان\nوكل حيوان ناطق\n∴ الفرس ناطق",
			"type":"text",
			"x":-340,
			"y":280,
			"width":180,
			"height":110
		},
		{
			"id":"e6f951d9c9cbb407",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(1) استعمال اللفظ المشترك في القياس",
			"type":"text",
			"x":-120,
			"y":-55,
			"width":260,
			"height":60
		},
		{
			"id":"57e0a01c4666fc85",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(2) استعال اللفظ المباين كالمرادف",
			"type":"text",
			"x":-120,
			"y":25,
			"width":260,
			"height":60
		},
		{
			"id":"a3cb3cd9b3c21bef",
			"styleAttributes":{},
			"text":"هذه عين (شمس) \nوكل عين (تنبع الماء) سيالة\n∴ هذه سيالة",
			"type":"text",
			"x":-400,
			"y":-200,
			"width":240,
			"height":110
		},
		{
			"id":"b73cb07a7952ef0e",
			"styleAttributes":{},
			"text":"هذا سيف\nوكل سيف صارم\n∴  هذا صارم",
			"type":"text",
			"x":-340,
			"y":-70,
			"width":180,
			"height":100
		},
		{
			"id":"19fffe0c02f40545",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(2) جعل النتيجة إحدى المقدمتين بتغييرها",
			"type":"text",
			"x":-120,
			"y":185,
			"width":260,
			"height":60
		},
		{
			"id":"1cd3092fe4b310ce",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(3) حكم الجنس بحكم النوع",
			"type":"text",
			"x":-120,
			"y":265,
			"width":260,
			"height":60
		},
		{
			"id":"727250db61a5f101",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(4) جعل الأمر الوهمي غير القطعي كالقطعي",
			"type":"text",
			"x":-120,
			"y":345,
			"width":260,
			"height":60
		},
		{
			"id":"6112f9e05af4b38e",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(1) التباس قضية كاذبة، بقضية صادقة",
			"type":"text",
			"x":-120,
			"y":105,
			"width":260,
			"height":60
		},
		{
			"id":"b5f6142da28d6b3a",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(1) أن لا يكون على هيئة شكل من الأشكال الأربعة",
			"type":"text",
			"x":-120,
			"y":425,
			"width":260,
			"height":60
		},
		{
			"id":"37d846bb2543dc7d",
			"styleAttributes":{
				"border":null,
				"shape":null
			},
			"text":"(2) فقد شرط من شروط الإنتاج المتقدمة للأشكال الأربعة",
			"type":"text",
			"x":-120,
			"y":505,
			"width":260,
			"height":90
		},
		{
			"id":"d1bf488100e51d48",
			"styleAttributes":{},
			"text":"هذا يتكلم بألفاظ العلم\nوكل من يتكلم بألفاظ العلم عالم\n∴ هذا عالم",
			"type":"text",
			"x":-440,
			"y":410,
			"width":280,
			"height":120
		},
		{
			"id":"2d49f2dbb64a42ca",
			"styleAttributes":{},
			"text":"كل إنسان حيوان\nوكل حجر جماد",
			"type":"text",
			"x":-350,
			"y":550,
			"width":190,
			"height":90
		},
		{
			"id":"d3c4023450433d17",
			"styleAttributes":{},
			"text":"لا شيء من الإنسان بحجر\nوكل حجر جسم\n∴ لا شيء من الإنسان بجسم، ",
			"type":"text",
			"x":-420,
			"y":660,
			"width":260,
			"height":100
		},
		{
			"id":"fb031f0c039266ae",
			"styleAttributes":{},
			"text":"**خطأ البرهان**",
			"type":"text",
			"x":620,
			"y":275,
			"width":160,
			"height":60,
			"color":"1"
		},
		{
			"id":"35220ab7031e5901",
			"styleAttributes":{},
			"text":"من جهة الصورة",
			"type":"text",
			"x":400,
			"y":470,
			"width":180,
			"height":60,
			"color":"1"
		},
		{
			"id":"c7bf767efaad89ae",
			"styleAttributes":{},
			"text":"من جهة المادة",
			"type":"text",
			"x":400,
			"y":100,
			"width":180,
			"height":60,
			"color":"1"
		},
		{
			"id":"e62268620dd8d56d",
			"styleAttributes":{},
			"text":" المعنى",
